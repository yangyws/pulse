    <string name="cpu_floor_label">CPU Floor</string>
    <string name="cpu_floor_desc">Holds the CPU clusters above this share of their max (scaling_min_freq) — snappier response, more idle draw. Clamped below your cap.</string>
    <string name="prime_boost_label">Limit Prime core boost</string>
